{
    "name": "ping-localhost/web-thumbnailer",
    "description": "PHP library which retrieves a thumbnail for any given URL",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arthur Hoaro",
            "homepage": "https://hoa.ro"
        },
        {
            "name": "Mitchell",
            "homepage": "https://github.com/ping-localhost"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "replace": {
        "arthurhoaro/web-thumbnailer": "self.version"
    },
    "autoload": {
        "psr-4": {
            "WebThumbnailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebThumbnailer\\": "tests/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
