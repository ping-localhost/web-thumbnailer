{
    "name": "ping-localhost/web-thumbnailer",
    "description": "PHP library which will retrieve a thumbnail for any given URL",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arthur Hoaro",
            "homepage": "https://hoa.ro"
        },
        {
            "name": "Mitchell",
            "homepage": "https://github.com/ping-localhost"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-gd": "*"
    },
    "require-dev": {
        "gskema/phpcs-type-sniff": "^0.13.1",
        "php-coveralls/php-coveralls": "^2.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "replace": {
        "arthurhoaro/web-thumbnailer": "self.version"
    },
    "autoload": {
        "psr-4": {
            "WebThumbnailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebThumbnailer\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
